{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(npx:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(python -m pip install:*)",
      "Bash(py -m pip install:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(poetry add:*)",
      "Bash(conda install:*)",
      "Bash(dotnet add package:*)",
      "Bash(nuget install:*)",
      "Bash(choco install:*)",
      "Bash(winget install:*)",
      "Bash(apt install:*)",
      "Bash(apt-get install:*)",
      "Bash(go get:*)",
      "Bash(cargo add:*)",
      "Bash(cargo install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(git clone:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash <(sed \"s/\\r$//\" ~/.claude/hooks/check-build.sh)'",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
